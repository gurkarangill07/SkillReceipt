# Optional practice coach. Server-only: never use a NEXT_PUBLIC_ prefix.
# Point to an existing local Ollama service; no downloads or cloud fallback.
# Only loopback URLs without credentials, query strings, or extra paths are accepted.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest

# Coach requests have a fixed 45s deadline, at most 3 short suggestions,
# a 30s per-receipt cooldown, and at most 2 simultaneous generations.
# Copy to .env.local only if overriding defaults. Do not commit .env.local.
# Optional server-only store override. Defaults to .data under the running directory.
# SKILLRECEIPT_DATA_DIR=.data
# Never commit runtime receipts. This store supports a single server process.

# Vercel deployment: connect a PRIVATE Blob store. This server-only token is
# configured by Vercel; never commit its value or use a NEXT_PUBLIC_ prefix.
# BLOB_READ_WRITE_TOKEN=
